// Prisma schema — Swiss web studio
//
// Postgres, because the app runs on Vercel: serverless functions get a
// read-only filesystem that is discarded between invocations, so a SQLite file
// has nowhere to live and lead capture would fail in production.
//
// Two URLs are needed. DATABASE_URL is the *pooled* connection used at runtime
// — serverless opens many short-lived connections and would otherwise exhaust
// Postgres' connection limit. DIRECT_URL bypasses the pooler for migrations,
// which need a single long-lived session.
//
// Run `npx prisma migrate dev --name init` to create the baseline.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  tier      String? // showcase | growth | partnership | null
  source    String? // hero | services | final-cta | direct
  locale    String   @default("fr")
  userAgent String?
  ip        String?

  @@index([createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  confirmed    Boolean  @default(false)
  confirmToken String?  @unique
  locale       String   @default("fr")
  source       String?

  @@index([createdAt])
}
