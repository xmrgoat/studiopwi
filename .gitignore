# Every env file, including timestamped backups and any local variant.
# The previous three-line list matched .env and .env.local exactly but not
# things like .env.bak-20260819, leaving live API keys one `git add .`
# away from being committed.
.env*
!.env.example

prisma/*.db
prisma/*.db-journal
prisma/migrations/

next-env.d.ts
.vercel
.turbo

coverage/
*.tsbuildinfo

# VPS deployment — local-only infra: scripts, secrets, keys (never commit)
vps/
